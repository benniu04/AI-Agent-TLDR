# Copy to .env and fill in. NEVER commit .env.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Model the agent runs on. Flip to claude-opus-4-8 for harder editorial judgment.
MODEL=claude-sonnet-4-6

# Telegram delivery (create a bot via @BotFather, then get your chat id)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# --- Optional bound overrides (defaults live in config.py) ---
# MAX_ITERATIONS=15
# MAX_TOKENS_BUDGET=200000
# WALL_CLOCK_SECONDS=180
