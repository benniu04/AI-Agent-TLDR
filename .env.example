# Copy to .env and fill in. NEVER commit .env.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Model the agent runs on. Flip to claude-opus-4-8 for harder editorial judgment.
MODEL=claude-sonnet-4-6

# Delivery channel: "sms" (Twilio) or "telegram"
DELIVERY=sms
# Headlines per section in the delivered briefing
MAX_HEADLINES_PER_SECTION=5

# --- Twilio SMS (DELIVERY=sms) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567
# Comma-separated recipient numbers in E.164 format
SMS_RECIPIENTS=+15557654321,+15559876543

# --- Telegram (DELIVERY=telegram) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# --- Optional bound overrides (defaults live in config.py) ---
# MAX_ITERATIONS=15
# MAX_TOKENS_BUDGET=200000
# WALL_CLOCK_SECONDS=180
