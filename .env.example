# Copy to .env and fill in. NEVER commit .env.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Model the agent runs on. Flip to claude-opus-4-8 for harder editorial judgment.
MODEL=claude-sonnet-4-6

# Headlines per section in the delivered briefing
MAX_HEADLINES_PER_SECTION=5
# IANA timezone for the digest date label (default America/New_York)
TIMEZONE=America/New_York

# --- Finance news APIs (free; get_finance_news uses whichever are set) ---
# Finnhub: https://finnhub.io/register   Alpha Vantage: https://www.alphavantage.co/support/#api-key
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- Telegram delivery ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# --- Optional bound overrides (defaults live in config.py) ---
# MAX_ITERATIONS=15
# MAX_TOKENS_BUDGET=300000
# WALL_CLOCK_SECONDS=480
# MAX_STORY_AGE_DAYS=3
# MEMORY_KEEP_DAYS=7
